{
  "name": "khuimeng",
  "version": "0.1.0",
  "description": "Report-driven multi-agent engineering pipeline — Coder→Viewer→Tester with dual-gate governance, sandbox and true multi-LLM seats",
  "license": "MIT",
  "type": "module",
  "bin": {
    "khuimeng": "bin/khuimeng.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx examples/mvp-debate.ts",
    "start": "tsx bin/cli.ts",
    "pipeline": "tsx bin/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tui": "tsx bin/cli.ts tui",
    "mvp": "tsx examples/mvp-debate.ts"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.5.0",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "src",
    "agents",
    "configs",
    "skills",
    "README.md",
    "README.zh-TW.md",
    "LICENSE",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaludPCB/Khuimeng.git"
  },
  "homepage": "https://github.com/SaludPCB/Khuimeng#readme",
  "bugs": {
    "url": "https://github.com/SaludPCB/Khuimeng/issues"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "llm",
    "code-review",
    "cli",
    "typescript"
  ],
  "funding": "https://ko-fi.com/saludpcb"
}
